# Apex domain + URL of the portal (used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://agnau.be
NEXT_PUBLIC_APEX_DOMAIN=agnau.be

# Set to "false" to keep all links on the apex during development.
# When omitted/true, production links cross-host to subdomains
# (e.g. https://renovatie.agnau.be).
NEXT_PUBLIC_USE_SUBDOMAINS=true

# Marketing / tracking
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Mail (server-side via Resend)
RESEND_API_KEY=
CONTACT_EMAIL=info@agnau.be

# Optional CRM webhook to push leads
CRM_WEBHOOK_URL=
